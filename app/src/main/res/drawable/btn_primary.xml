<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#c6d900"
                android:endColor="#9fb000"
                android:angle="90"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#fff177"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#22221100"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#443300"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#fff177"
                android:endColor="#eaff00"
                android:angle="90"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
