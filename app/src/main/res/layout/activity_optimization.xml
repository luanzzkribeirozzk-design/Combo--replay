<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080800">

    <com.replayx.app.ui.ParticleView
        android:id="@+id/particleViewOpt"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- BACKGROUND IMAGE -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_volpp_grad"
        android:scaleType="centerCrop"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000088"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BY: DEV WILL"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.4"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otimização"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OTIMIZAÇÃO  ·  DEV WILL"
                    android:textColor="#7B00AA"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvShizukuStatusOpt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● VERIFICANDO"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#BF00FF" />

        <!-- BOTOES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#00000066">

            <Button
                android:id="@+id/btnAtivarOtimizacao"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="ATIVAR OTIMIZAÇÃO"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplica os ajustes de FPS e desempenho via Shizuku"
                android:textColor="#006600"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnDesativarOtimizacao"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="DESATIVAR OTIMIZAÇÃO"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaura todas as configurações originais (reset)"
                android:textColor="#006600"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnVoltarOpt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="VOLTAR"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_clear"
                android:stateListAnimator="@null"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnClearLogOpt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Limpar logs"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_clear"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#181200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000088"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="root@devwill:~/ optimization_log"
                android:textColor="#00AA22"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.0"
                android:textColor="#003311"
                android:textSize="10sp" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLogOpt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00000099"
            android:padding="12dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvLogOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000088"
            android:paddingVertical="8dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dev Will  ·  Dev Will"
                android:textColor="#7B00AA"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
