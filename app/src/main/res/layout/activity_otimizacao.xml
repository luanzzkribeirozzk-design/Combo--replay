<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#050500"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/bg_volpp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#ee060600"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:elevation="6dp">
            <Button
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnOtimVoltar"
                android:background="@drawable/btn_clear"
                android:padding="0dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="◀"
                android:stateListAnimator="@null"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#eaff00"
                android:gravity="center"
                android:background="@drawable/ic_hex_bg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="W"
                android:layout_marginStart="10dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#eaff00"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OTIMIZADOR FF"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#4a4720"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEV WILL TECHX  ·  Free Fire &amp; FF MAX"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#eaff00"
                android:id="@+id/tvOtimStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRONTO"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"/>
        </LinearLayout>
        <View
            android:background="#bf00ff"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#bb060600"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/card_otim_bg"
                android:padding="14dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#eaff00"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="▲"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#eaff00"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OTIMIZAR"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#4a4720"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="54 comandos"/>
                <Button
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:id="@+id/btnAplicarOtimizacao"
                    android:background="@drawable/btn_primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="APLICAR"
                    android:elevation="3dp"
                    android:stateListAnimator="@null"
                    android:letterSpacing="0.04"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/card_reset_bg"
                android:padding="14dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#cc66ff"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="↺"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#cc66ff"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESETAR"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#4a4720"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Reverte tudo"/>
                <Button
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnResetOtimizacao"
                    android:background="@drawable/btn_reset"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="RESETAR"
                    android:elevation="3dp"
                    android:stateListAnimator="@null"
                    android:letterSpacing="0.04"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#181200"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#aa060600"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#00aa22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="root@devwill:~/ "
                android:fontFamily="monospace"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#eaff00"
                android:id="@+id/tvContador"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>
            <ProgressBar
                android:id="@+id/progressOtimizacao"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:progressDrawable="@drawable/progress_otim"
                android:layout_weight="1"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#bb060600"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#eaff00"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUTPUT"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="#22eaff00"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scrollOtimLog"
            android:background="#cc000000"
            android:padding="12dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="10.5sp"
                android:textColor="#cccccc"
                android:id="@+id/tvOtimLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:lineSpacingExtra="3dp"
                android:fontFamily="monospace"/>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:background="#ee060600"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp">
            <TextView
                android:textSize="9sp"
                android:textColor="#7b00aa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEV WILL TECHX  ·  Otimizador Free Fire"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
