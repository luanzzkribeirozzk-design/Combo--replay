<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#050000"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⛔"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KEY EXPIRADA"
        android:textColor="#FF4444"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O tempo de acesso dessa key acabou.\nFaça login com uma key valida para continuar."
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnLoginExpired"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="FAZER LOGIN NOVAMENTE"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/btn_primary"
        android:stateListAnimator="@null" />

</LinearLayout>
