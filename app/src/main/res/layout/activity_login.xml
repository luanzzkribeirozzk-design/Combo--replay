<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#080800"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_volpp"
        android:scaleType="centerCrop"
        android:alpha="0.7"/>
    <FrameLayout
        android:id="@+id/splashScreen"
        android:background="#000000"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="100dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5">
            <TextView
                android:textSize="10sp"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFICANDO"
                android:fontFamily="monospace"
                android:letterSpacing="0.4"/>
        </LinearLayout>
    </FrameLayout>
    <com.replayx.app.p005ui.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="36dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BY: DEV WILL"
                    android:letterSpacing="0.4"/>
                <TextView
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:textColor="#ffd700"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dev Will"
                    android:shadowColor="#dd00ff"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#7b00aa"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="BYPASS  ·  DEV WILL"
                    android:letterSpacing="0.2"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/card_login"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="ACESSO COM KEY"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="HIDE STREAM"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHideStreamLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#7b00aa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="KEY DE ACESSO"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:textColorHint="#1e1600"
                    android:id="@+id/etKey"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:hint="usuario&gt;senha"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:fontFamily="monospace"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRemember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lembrar key"
                        android:fontFamily="monospace"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
                <Button
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:id="@+id/btnLogin"
                    android:background="@drawable/btn_primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="ENTRAR"
                    android:stateListAnimator="@null"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/tvError"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:fontFamily="monospace"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progressBar"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="#ffa500"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutTimer"
                android:background="@drawable/card_timer"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="9sp"
                    android:textColor="#7b00aa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="TEMPO RESTANTE"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"/>
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/tvTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00d 00h 00m 00s"
                    android:fontFamily="monospace"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#7b00aa"
                    android:gravity="center"
                    android:id="@+id/tvKeyUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <TextView
                android:textSize="9sp"
                android:textColor="#1e1600"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:text="Dev Will  ·  Dev Will"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
