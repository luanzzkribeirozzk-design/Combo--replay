<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#080800"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#e6050500"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">
        <View
            android:background="#bf00ff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"/>
        <Button
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/btnSensiConfig"
            android:background="@drawable/btn_primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="▣  SENSI CONFIG"
            android:stateListAnimator="@null"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#7b00aa"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configurador de Sensibilidade · DEV WILL TECHX"/>
        <View
            android:background="#1aeaff00"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"/>
        <Button
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#eaff00"
            android:id="@+id/btnOtimizador"
            android:background="@drawable/btn_clear"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="▲  OTIMIZADOR FF"
            android:stateListAnimator="@null"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#7b00aa"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FPS Máximo · 54 Comandos · Free Fire &amp; FF MAX"/>
    </LinearLayout>
    <com.replayx.app.p005ui.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_volpp"
        android:scaleType="centerCrop"
        android:alpha="0.6"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="#00000088"
            android:paddingTop="44dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BY: DEV WILL"
                android:letterSpacing="0.4"/>
            <TextView
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dev Will"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#7b00aa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="BYPASS  ·  DEV WILL"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#ffd700"
                    android:id="@+id/tvShizukuStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● VERIFICANDO"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="9sp"
                    android:textColor="#7b00aa"
                    android:id="@+id/tvKeyInfo"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="1"
                    android:fontFamily="monospace"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00d 00h 00m 00s"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#bf00ff"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#00000099"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIDE STREAM"
                    android:fontFamily="monospace"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#444444"
                    android:id="@+id/tvHideStreamStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="HIDE STREAM: OFF"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHideStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>
        <View
            android:background="#181200"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="#00000066"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/btnBypassMaxToNormal"
                android:background="@drawable/btn_primary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="4dp"
                android:text="BYPASS  FFM = FFN"
                android:stateListAnimator="@null"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#006600"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Free Fire MAX  →  Free Fire Normal"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/btnBypassNormalToMax"
                android:background="@drawable/btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="4dp"
                android:text="BYPASS  FFN = FFM"
                android:stateListAnimator="@null"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#006600"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Free Fire Normal  →  Free Fire MAX"/>
            <Button
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnClearLog"
                android:background="@drawable/btn_clear"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Limpar logs"
                android:stateListAnimator="@null"/>
        </LinearLayout>
        <View
            android:background="#181200"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#00000088"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#00aa22"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="root@devwill:~/ bypass_log"
                android:layout_weight="1"
                android:fontFamily="monospace"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#003311"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.0"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scrollLog"
            android:background="#00000099"
            android:padding="12dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:lineSpacingExtra="2dp"
                android:fontFamily="monospace"/>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:background="#00000088"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">
            <TextView
                android:textSize="9sp"
                android:textColor="#7b00aa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dev Will  ·  Dev Will"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
